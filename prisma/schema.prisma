// SportMatch — schema theo `.claude/rules/data-model.md`.
// Sport là bảng mở rộng được: thêm môn mới chỉ cần insert thêm row, không sửa core.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum SkillLevel {
  BEGINNER // Mới chơi
  INTERMEDIATE // Trung cấp
  ADVANCED // Chuyên nghiệp
}

enum Gender {
  MALE // Nam
  FEMALE // Nữ
  OTHER // Khác
}

enum Weekday {
  MON // Thứ hai
  TUE // Thứ ba
  WED // Thứ tư
  THU // Thứ năm
  FRI // Thứ sáu
  SAT // Thứ bảy
  SUN // Chủ nhật
}

enum MatchVisibility {
  PUBLIC // Công khai
  INVITE // Theo lời mời
  PRIVATE // Riêng tư
}

enum MatchStatus {
  UPCOMING // Sắp diễn ra
  ONGOING // Đang diễn ra
  COMPLETED // Đã hoàn tất
}

enum ParticipantStatus {
  INVITED // invited
  REQUESTED // xin vào trận công khai, chờ chủ trận duyệt
  JOINED // joined
  LEFT // left
}

enum NotificationType {
  INVITE
  JOIN
  RATING
  SYSTEM
}

// ---------------------------------------------------------------- auth + user

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?

  // Avatar hệ thống là emoji (theo ảnh gốc); `image` dành cho ảnh upload sau này.
  avatar         String    @default("🧑")
  bio            String    @default("")
  area           String    @default("")
  lat            Float?
  lng            Float?
  gender         Gender?
  birthday       DateTime?
  trustScore     Int       @default(80)
  isOnline       Boolean   @default(false)
  isPro          Boolean   @default(false)
  communityVotes Int       @default(0)
  onboardedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  sports        UserSport[]
  availability  Availability[]
  hostedMatches Match[]              @relation("MatchHost")
  participation MatchParticipant[]
  ratingsGiven  Rating[]             @relation("RatingFrom")
  ratingsGot    Rating[]             @relation("RatingTo")
  notifications Notification[]
  messages      ChatMessage[]
  conversations ConversationMember[]

  @@index([area])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------- thể thao

model Sport {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  icon      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users   UserSport[]
  matches Match[]
  courts  CourtSport[]
}

model UserSport {
  userId     String
  sportId    String
  skillLevel SkillLevel @default(BEGINNER)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([userId, sportId])
  @@index([sportId])
}

model Availability {
  userId String
  day    Weekday

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

// ---------------------------------------------------------------- trận đấu

model Match {
  id               String          @id @default(cuid())
  sportId          String
  hostId           String
  title            String
  courtName        String
  address          String          @default("")
  dateTime         DateTime
  maxPlayers       Int             @default(4)
  // null = "Bất kỳ"
  skillRequirement SkillLevel?
  visibility       MatchVisibility @default(PUBLIC)
  description      String          @default("")
  status           MatchStatus     @default(UPCOMING)
  courtId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sport        Sport              @relation(fields: [sportId], references: [id])
  host         User               @relation("MatchHost", fields: [hostId], references: [id], onDelete: Cascade)
  court        Court?             @relation(fields: [courtId], references: [id])
  participants MatchParticipant[]
  ratings      Rating[]
  conversation ChatConversation?

  @@index([sportId])
  @@index([hostId])
  @@index([dateTime])
  @@index([status])
}

model MatchParticipant {
  matchId  String
  userId   String
  status   ParticipantStatus @default(INVITED)
  joinedAt DateTime          @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([matchId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------- sân bãi

model Court {
  id           String   @id @default(cuid())
  name         String
  area         String
  address      String   @default("")
  pricePerHour Int      @default(0)
  phone        String   @default("")
  isOpen       Boolean  @default(true)
  lat          Float
  lng          Float
  createdAt    DateTime @default(now())

  sports  CourtSport[]
  matches Match[]

  @@index([area])
}

model CourtSport {
  courtId String
  sportId String

  court Court @relation(fields: [courtId], references: [id], onDelete: Cascade)
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([courtId, sportId])
  @@index([sportId])
}

// ---------------------------------------------------------------- đánh giá

model Rating {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  matchId    String
  stars      Int
  comment    String   @default("")
  createdAt  DateTime @default(now())

  fromUser User  @relation("RatingFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User  @relation("RatingTo", fields: [toUserId], references: [id], onDelete: Cascade)
  match    Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // Mỗi người chỉ đánh giá một đồng đội một lần cho mỗi trận.
  @@unique([fromUserId, toUserId, matchId])
  @@index([toUserId])
  @@index([matchId])
}

// ---------------------------------------------------------------- thông báo

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @default("")
  payload   Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------- chat

model ChatConversation {
  id            String   @id @default(cuid())
  matchId       String   @unique
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  match    Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages ChatMessage[]

  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
